  {
    "id": "3_4_sit-up",
    "name": "3/4 Sit-Up",
    "indonesianName": "3/4 Sit-Up (Perut (Core))",
    "aliases": [
      "3/4 sit-up",
      "3_4_sit-up",
      "abdominals"
    ],
    "equipmentCategory": "bodyweight",
    "equipmentName": "Body only",
    "bodyPart": "abdominals",
    "targetMuscles": [
      "Perut (Core)"
    ],
    "secondaryMuscles": [],
    "equipmentSetup": [
      "Sesuaikan posisi bantalan, pin beban, atau pegangan alat sesuai postur tubuh.",
      "Pastikan tumpukan beban terkunci aman sebelum memulai repetisi."
    ],
    "instructions": [
      "Lie down on the floor and secure your feet. Your legs should be bent at the knees.",
      "Place your hands behind or to the side of your head. You will begin with your back on the ground. This will be your starting position.",
      "Flex your hips and spine to raise your torso toward your knees.",
      "At the top of the contraction your torso should be perpendicular to the ground. Reverse the motion, going only ¾ of the way down.",
      "Repeat for the recommended amount of repetitions."
    ],
    "dosAndDonts": {
      "dos": [
        "Jaga postur punggung tetap netral dan kontrol kecepatan gerakan."
      ],
      "donts": [
        "Hindari menggunakan momentum tubuh berlebih saat mengangkat beban."
      ]
    },
    "coachCues": {
      "max": "Fokus ke otot target lo bro! Rasain kontraksinya di setiap repetisi. Gas!",
      "mia": "Kontrol gerakannya perlahan ya, rasakan aktivasi otot dengan napas teratur. ✨"
    },
    "recommendedSetsReps": "3-4 Set x 10-12 Repetisi",
    "gifUrl": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/3_4_Sit-Up/0.jpg",
