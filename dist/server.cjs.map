    "name": "Front Cone Hops (or hurdle hops)",
    "indonesianName": "Front Cone Hops (or hurdle hops) (Paha Depan (Quads))",
    "aliases": [
      "front cone hops (or hurdle hops)",
      "front_cone_hops_or_hurdle_hops",
      "quadriceps"
