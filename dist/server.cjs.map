  {
    "id": "air_bike",
    "name": "Air Bike",
    "indonesianName": "Air Bike (Perut (Core))",
    "aliases": [
      "air bike",
      "air_bike",
      "abdominals"
    ],
    "equipmentCategory": "bodyweight",
    "equipmentName": "Body only",
