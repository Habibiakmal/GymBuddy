    "name": "Thigh Adductor",
    "indonesianName": "Thigh Adductor (Paha Dalam (Adductors))",
    "aliases": [
      "thigh adductor",
      "thigh_adductor",
      "adductors"
    ],
    "equipmentCategory": "machine",
