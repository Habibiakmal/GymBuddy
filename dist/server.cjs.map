  {
    "id": "front_squat_clean_grip",
    "name": "Front Squat (Clean Grip)",
    "indonesianName": "Front Squat (Clean Grip) (Paha Depan (Quads))",
    "aliases": [
      "front squat (clean grip)",
      "front_squat_clean_grip",
      "quadriceps"
    ],
    "equipmentCategory": "barbell",
    "equipmentName": "Barbell",
    "bodyPart": "quadriceps",
