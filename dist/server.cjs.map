    "targetMuscles": [
      "Paha Dalam (Adductors)"
    ],
    "secondaryMuscles": [
      "Bokong (Glutes)",
      "Paha Belakang (Hamstrings)"
    ],
    "equipmentSetup": [
      "Sesuaikan posisi bantalan, pin beban, atau pegangan alat sesuai postur tubuh.",
      "Pastikan tumpukan beban terkunci aman sebelum memulai repetisi."
    ],
    "instructions": [
      "To begin, sit down on the adductor machine and select a weight you are comfortable with. When your legs are positioned properly on the leg pads of the machine, grip the handles on each side. Your entire upper body (from the waist up) should be stationary. This is the starting position.",
      "Slowly press against the machine with your legs to move them towards each other while exhaling.",
      "Feel the contraction for a second and begin to move your legs back to the starting position while breathing in. Note: Remember to keep your upper body stationary and avoid fast jerking motions in order to prevent any injuries from occurring.",
      "Repeat for the recommended amount of repetitions."
    ],
    "dosAndDonts": {
      "dos": [
        "Jaga postur punggung tetap netral dan kontrol kecepatan gerakan."
      ],
      "donts": [
        "Hindari menggunakan momentum tubuh berlebih saat mengangkat beban."
      ]
    },
    "coachCues": {
      "max": "Fokus ke otot target lo bro! Rasain kontraksinya di setiap repetisi. Gas!",
      "mia": "Kontrol gerakannya perlahan ya, rasakan aktivasi otot dengan napas teratur. ✨"
    },
    "recommendedSetsReps": "3-4 Set x 10-12 Repetisi",
    "gifUrl": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Thigh_Adductor/0.jpg",
